{
  "name": "@continuum-js/router",
  "version": "0.1.4",
  "description": "Continuum router — the URL as a Behavior: nested routes, typed params, lazy pages, guards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denislibs/continuum.git",
    "directory": "packages/router"
  },
  "type": "module",
