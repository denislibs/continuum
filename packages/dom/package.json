{
  "name": "@continuum-js/dom",
  "version": "0.16.0",
  "description": "Continuum DOM renderer \u2014 fine-grained bindings, dynamic regions, ownership, context",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denislibs/continuum.git",
    "directory": "packages/dom"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json",
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "import": "./dist/compiled.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@continuum-js/frp": "0.16.0"
  }
}
