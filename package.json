{
  "name": "continuum-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Continuum — classic FRP (Behaviors + Events) with fine-grained rendering",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmark"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "npm run build -w @continuum/frp && npm run build -w @continuum/std && npm run build -w @continuum/dom",
    "smoke": "node scripts/smoke.mjs",
    "size": "size-limit",
    "bench": "npm run bench -w @continuum/benchmark",
    "example:counter": "npm run dev -w @continuum/example-counter",
    "example:todo": "npm run dev -w @continuum/example-todo",
    "example:animation": "npm run dev -w @continuum/example-animation",
    "example:showcase": "npm run dev -w @continuum/example-showcase",
    "example:data": "npm run dev -w @continuum/example-data"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.61.0",
    "size-limit": "^11.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
