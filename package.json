{
  "name": "continuum-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Continuum — classic FRP (Behaviors + Events) with fine-grained rendering",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "example:counter": "npm run dev -w @continuum/example-counter",
    "example:todo": "npm run dev -w @continuum/example-todo",
    "example:animation": "npm run dev -w @continuum/example-animation"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
